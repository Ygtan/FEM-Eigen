*NODE
1 0.0 0.0
2 1.0 0.0
3 2.0 0.0
*ET
1 CABLE
*MP
1 E=200e9
*R
1 A=0.01 ISTRN=0.001
*TYPE,1
*MAT,1
*REAL,1
*EN,1,1,2
*EN,2,2,3
*BOUNDARY
1 1-3 0.0
3 1-3 0.0
2 3 0.0
*INFLUENCE
1 DISP 2 2
*LANE_LOAD
1 NODES=1-3 Q=-10.0 P=-100.0 DIR=GY METHOD=NONLINEAR
*END
