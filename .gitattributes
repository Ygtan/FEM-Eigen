# 统一换行符与编码，避免跨机器/跨平台逐字节回归误报
* text=auto
*.dat    text eol=lf
*.result text eol=lf
*.txt    text eol=lf
*.csv    text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.cpp    text eol=lf
*.hpp    text eol=lf
*.h      text eol=lf
*.py     text eol=lf
*.ps1    text eol=lf
*.cmake  text eol=lf
CMakeLists.txt text eol=lf
*.inp    text eol=lf

# 二进制
*.png  binary
*.jpg  binary
*.exe  binary
*.a    binary
*.dll  binary
*.obj  binary
