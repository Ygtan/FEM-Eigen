# AEMM 徐变 + 收缩验证。
# E=200e9，PHI=1.0，CHI=0.8 -> E_eff = 200e9/1.8 = 1.11111e11 Pa。
# 无收缩时 P=1000 的位移 = P*L/(E_eff*A) = 9.0e-6 m。
# ECS=0.001 的收缩自由缩短 = -0.001 m。
*CREEP
ALL PHI=1.0 CHI=0.8
*SHRINKAGE
ALL ECS=0.001
*NODE
1 0.0 0.0
2 1.0 0.0
*ET
1 TRUSS
*MP
1 E=200e9
*R
1 A=0.001
*TYPE,1
*MAT,1
*REAL,1
*EN,1,1,2
*BOUNDARY
1 1-3 0.0
2 2-3 0.0
*CLOAD
2 1 1000.0
*END
