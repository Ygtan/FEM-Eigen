/BATCH
/TITLE,CB3D16 large-rotation beam-column - CIR050
/PREP7
ET,1,BEAM188
KEYOPT,1,1,0
KEYOPT,1,3,0
! ASEC: integrated section properties, no ANSYS I/J recompute
SECTYPE,1,BEAM,ASEC
SECDATA,2.000000000000E-02,5.000000000000E-02,0,2.000000000000E-04,0,1.000000000000E-02,0,0,0,0
SECNUM,1
MP,EX,1,2.100000000000E+11
MP,PRXY,1,0.3
MP,GXY,1,8.100000000000E+10
! ---- nodes: straight beam along global X ----
N,1,0.000000000000E+00,0,0
N,2,1.250000000000E+00,0,0
N,3,2.500000000000E+00,0,0
N,4,3.750000000000E+00,0,0
N,5,5.000000000000E+00,0,0
N,6,6.250000000000E+00,0,0
N,7,7.500000000000E+00,0,0
N,8,8.750000000000E+00,0,0
N,9,1.000000000000E+01,0,0
TYPE,1
MAT,1
E,1,2
E,2,3
E,3,4
E,4,5
E,5,6
E,6,7
E,7,8
E,8,9
! ---- boundary conditions ----
D,1,ALL,0
! ---- nodal loads (dead load, same global direction as FEM *CLOAD) ----
F,9,MZ,1.319468914508E+07
FINISH
/SOLU
ANTYPE,STATIC
NLGEOM,ON
CNVTOL,F,1.000000000000E-02,0.005,2
NSUBST,100,500,10
NEQIT,200
OUTRES,ALL,LAST
SOLVE
FINISH
! ---- post-processing: machine-readable CSV ----
/POST1
SET,LAST
*DIM,ADSP,ARRAY,9,7
*DO,I,1,9
 ADSP(I,1)=I
 *GET,TMP,NODE,I,U,X
 ADSP(I,2)=TMP
 *GET,TMP,NODE,I,U,Y
 ADSP(I,3)=TMP
 *GET,TMP,NODE,I,U,Z
 ADSP(I,4)=TMP
 *GET,TMP,NODE,I,ROT,X
 ADSP(I,5)=TMP
 *GET,TMP,NODE,I,ROT,Y
 ADSP(I,6)=TMP
 *GET,TMP,NODE,I,ROT,Z
 ADSP(I,7)=TMP
*ENDDO
*CFOPEN,cir050_disp,csv
*VWRITE,ADSP(1,1),ADSP(1,2),ADSP(1,3),ADSP(1,4),ADSP(1,5),ADSP(1,6),ADSP(1,7)
 (1X,F8.0,6(1X,E18.10))
*CFCLOS
FINISH
/EXIT,NOSAVE
