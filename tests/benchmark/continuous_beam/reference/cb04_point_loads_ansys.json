{
  "id": "cb04_point_loads",
  "dat": "cb04_point_loads.dat",
  "inp": "cb04_point_loads.inp",
  "exe": "example_mixed.exe",
  "description": "两跨连续梁 2x20 m（CB01 几何），无均布荷载、无自重；左右两跨跨中节点 6 / 16 各施加 200 kN 向下集中力，总荷载 400 kN。",
  "load_case": "two -200 kN point loads at nodes 6/16; FEM *CLOAD <-> ANSYS F,<node>,FY,-200000",
  "reference_source": "ANSYS 18.0 / BEAM3 批处理实测，冻结 CSV 见 cases/cb04_point_loads_ansys_*.csv；由 build_reference.py 从这些 CSV 抽取，非解析解、非 FEM-Eigen 自测值。",
  "ansys": {
    "release": "18.0",
    "element": "BEAM3",
    "mode": "batch -b",
    "csv_columns": {
      "disp": "UX/UY/ROTZ",
      "reac": "FX/FY",
      "elem": "NI/VI/MI/NJ/VJ/MJ",
      "spring": "node/SMISC1"
    }
  },
  "same_source_apdl": "cases/cb04_point_loads.inp 与 cases/cb04_point_loads.dat 由同一个 BridgeSpec 对象生成（BridgeStudio/ansys_bridge.py），节点/单元/材料/截面/约束/荷载完全一致。",
  "tolerances": {
    "default_rtol": 0.001,
    "comment": "|got-ref| <= atol + rtol*|ref|"
  },
