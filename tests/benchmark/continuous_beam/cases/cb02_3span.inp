/BATCH
/TITLE,CB02 three-span continuous box beam 3x30m UDL 20kN/m
! Generated by BridgeStudio/ansys_bridge.py from ONE BridgeSpec
! Same nodes/elements/material/section/BC/loads as the FEM-Eigen .dat
/PREP7
! ---- Element type: 2D elastic beam (Euler-Bernoulli) ----
ET,1,BEAM3
! ---- Real constant: ARCT, IZZ, HEIGHT ----
R,1,0.478,0.4147995833,2
! ---- Material ----
MP,EX,1,2.06e+11
MP,PRXY,1,0.3
MP,DENS,1,7850
MP,ALPX,1,1.2e-05
! ---- Nodes ----
N,1,0,0,0.0
N,2,3,0,0.0
N,3,6,0,0.0
N,4,9,0,0.0
N,5,12,0,0.0
N,6,15,0,0.0
N,7,18,0,0.0
N,8,21,0,0.0
N,9,24,0,0.0
N,10,27,0,0.0
N,11,30,0,0.0
N,12,33,0,0.0
N,13,36,0,0.0
N,14,39,0,0.0
N,15,42,0,0.0
N,16,45,0,0.0
N,17,48,0,0.0
N,18,51,0,0.0
N,19,54,0,0.0
N,20,57,0,0.0
N,21,60,0,0.0
N,22,63,0,0.0
N,23,66,0,0.0
N,24,69,0,0.0
N,25,72,0,0.0
N,26,75,0,0.0
N,27,78,0,0.0
N,28,81,0,0.0
N,29,84,0,0.0
N,30,87,0,0.0
N,31,90,0,0.0
! ---- Elements ----
TYPE,1
MAT,1
REAL,1
E,1,2
E,2,3
E,3,4
E,4,5
E,5,6
E,6,7
E,7,8
E,8,9
E,9,10
E,10,11
E,11,12
E,12,13
E,13,14
E,14,15
E,15,16
E,16,17
E,17,18
E,18,19
E,19,20
E,20,21
E,21,22
E,22,23
E,23,24
E,24,25
E,25,26
E,26,27
E,27,28
E,28,29
E,29,30
E,30,31
! ---- Boundary conditions (1=UX 2=UY 3=ROTZ) ----
D,1,UX,0
D,1,UY,0
D,11,UY,0
D,21,UY,0
D,31,UY,0
! ---- Loads ----
*DO,EID,1,30
 SFBEAM,EID,1,PRES,20000,20000
*ENDDO
! ---- Solve ----
FINISH
/SOLU
ANTYPE,STATIC
SOLVE
FINISH
! ---- Post-processing: export machine-readable results ----
/POST1
SET,LAST
! BEAM3 SMISC: 1/2/6 = N/V/M at I, 7/8/12 = N/V/M at J
ETABLE,ENI,SMISC,1
ETABLE,EVI,SMISC,2
ETABLE,EMI,SMISC,6
ETABLE,ENJ,SMISC,7
ETABLE,EVJ,SMISC,8
ETABLE,EMJ,SMISC,12
*DIM,ADSP,ARRAY,31,4
*DO,I,1,31
 ADSP(I,1)=I
 *GET,TMP,NODE,I,U,X
 ADSP(I,2)=TMP
 *GET,TMP,NODE,I,U,Y
 ADSP(I,3)=TMP
 *GET,TMP,NODE,I,ROT,Z
 ADSP(I,4)=TMP
*ENDDO
! *VWRITE with an array starting index writes ALL remaining rows;
! do NOT wrap it in a *DO loop (that duplicates the tail).
*CFOPEN,cb02_3span_disp,csv
*VWRITE,ADSP(1,1),ADSP(1,2),ADSP(1,3),ADSP(1,4)
 (1X,F8.0,3(1X,E18.10))
*CFCLOS
*DIM,ARCT,ARRAY,31,3
*DO,I,1,31
 ARCT(I,1)=I
 *GET,TMP,NODE,I,RF,FX
 ARCT(I,2)=TMP
 *GET,TMP,NODE,I,RF,FY
 ARCT(I,3)=TMP
*ENDDO
*CFOPEN,cb02_3span_reac,csv
*VWRITE,ARCT(1,1),ARCT(1,2),ARCT(1,3)
 (1X,F8.0,2(1X,E18.10))
*CFCLOS
*DIM,AELM,ARRAY,30,7
*DO,I,1,30
 AELM(I,1)=I
 *GET,TMP,ELEM,I,ETAB,ENI
 AELM(I,2)=TMP
 *GET,TMP,ELEM,I,ETAB,EVI
 AELM(I,3)=TMP
 *GET,TMP,ELEM,I,ETAB,EMI
 AELM(I,4)=TMP
 *GET,TMP,ELEM,I,ETAB,ENJ
 AELM(I,5)=TMP
 *GET,TMP,ELEM,I,ETAB,EVJ
 AELM(I,6)=TMP
 *GET,TMP,ELEM,I,ETAB,EMJ
 AELM(I,7)=TMP
*ENDDO
*CFOPEN,cb02_3span_elem,csv
*VWRITE,AELM(1,1),AELM(1,2),AELM(1,3),AELM(1,4),AELM(1,5),AELM(1,6),AELM(1,7)
 (1X,F8.0,6(1X,E18.10))
*CFCLOS
FINISH
/EXIT,NOSAVE
