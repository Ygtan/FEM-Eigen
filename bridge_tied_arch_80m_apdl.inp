! bridge_tied_arch_80m.dat 的基本 APDL 模型
! 只包含 ANSYS Mechanical APDL 可直接覆盖的模型、约束和基本荷载。
! 未展开：影响线、车道荷载包络、徐变收缩、规范温度梯度、自动预应力筋生成。

FINISH
/CLEAR,NOSTART
/FILNAME,bridge_tied_arch_80m
/TITLE,80m tied-arch bridge basic APDL model

/PREP7

! ===================== 单元类型 =====================
ET,1,BEAM3          ! 主梁/拱肋：二维弹性梁
ET,2,LINK1          ! 吊杆：二维杆，可输入初应变
ET,3,LINK1          ! STRUT 演示压杆

! ===================== 实常数 =====================
! BEAM3 实常数：AREA, IZZ, HEIGHT
R,1,0.80,0.096,1.20
R,2,0.08,0.005,0.50

! LINK1 实常数：AREA, ISTRN
R,3,0.001,0.001
R,4,0.001,-0.0005

! ===================== 材料 =====================
MP,EX,1,35e9
MP,ALPX,1,1.0e-5
MP,DENS,1,2500

MP,EX,2,200e9
MP,EX,3,195e9

! ===================== 节点 =====================
N,1,0.0,0.0
N,2,10.0,0.0
N,3,20.0,0.0
N,4,30.0,0.0
N,5,40.0,0.0
N,6,50.0,0.0
N,7,60.0,0.0
N,8,70.0,0.0
N,9,80.0,0.0

N,101,0.0,0.0
N,102,10.0,5.25
N,103,20.0,9.0
N,104,30.0,11.25
N,105,40.0,12.0
N,106,50.0,11.25
N,107,60.0,9.0
N,108,70.0,5.25
N,109,80.0,0.0

N,201,100.0,0.0
N,202,102.0,0.0

! ===================== 主梁单元 =====================
TYPE,1
MAT,1
REAL,1
*DO,I,1,8
  E,I,I+1
*ENDDO

! ===================== 拱肋单元 =====================
TYPE,1
MAT,2
REAL,2
*DO,I,101,108
  E,I,I+1
*ENDDO

! ===================== 吊杆单元 =====================
TYPE,2
MAT,3
REAL,3
*DO,I,2,8
  E,I,I+100
*ENDDO

! ===================== STRUT 压杆 =====================
TYPE,3
MAT,3
REAL,4
E,201,202

! ===================== 约束方程 CE =====================
CE,301,0.0,1,UX,1.0,101,UX,-1.0
CE,302,0.0,1,UY,1.0,101,UY,-1.0
CE,303,0.0,1,ROTZ,1.0,101,ROTZ,-1.0
CE,304,0.0,9,UX,1.0,109,UX,-1.0
CE,305,0.0,9,UY,1.0,109,UY,-1.0
CE,306,0.0,9,ROTZ,1.0,109,ROTZ,-1.0

! ===================== 支座约束 =====================
D,1,UX,0.0
D,1,UY,0.0
D,9,UY,0.0
D,201,ALL,0.0
D,202,ALL,0.0

! ===================== 基本荷载 =====================
! 拱肋节点竖向节点力 -2000 N
*DO,I,101,109
  F,I,FY,-2000.0
*ENDDO

! 主梁均布力 -5000 N/m
! 前 8 个单元为 deck BEAM3 单元
*DO,I,1,8
  SFBEAM,I,1,PRES,5000.0,5000.0
*ENDDO

! 自重
ACEL,0.0,9.81,0.0

! ===================== 求解 =====================
/SOLU
ANTYPE,STATIC
SOLVE
FINISH

SAVE

/POST1
 ETABLE,N1,SMISC,1 
 ETABLE,N2,SMISC,7 
 ETABLE,Qy1,SMISC,2 
 ETABLE,Qy2,SMISC,8
 ETABLE,My1,SMISC,3 
 ETABLE,My2,SMISC,9
ETABLE,Qz1,SMISC,4 
 ETABLE,Qz2,SMISC,10 
ETABLE,My1,SMISC,5
 ETABLE,My2,SMISC,11
 ETABLE,M1,SMISC,6 
 ETABLE,M2,SMISC,12 




