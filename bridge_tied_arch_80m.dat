# 综合算例：80 m 下承式系杆拱桥
# 功能覆盖：
#   BEAM 主梁/拱肋
#   CABLE 吊杆
#   STRUT 压杆演示
#   *PRESTRESS 主梁纵向预应力
#   *CE 拱脚刚接约束
#   *CREEP / *SHRINKAGE 混凝土长期效应
#   *TEMP_PROFILE 日照温度梯度
#   *GRAVITY 自重
#   *ANALYSIS NONLINEAR 几何非线性
#   *INFLUENCE / *LANE_LOAD 影响线与车道荷载包络
*ANALYSIS TYPE=NONLINEAR TOL=1e-6 MAXITER=100
*TITLE
80m tied-arch bridge comprehensive example

*NODE
1 0.0 0.0
2 10.0 0.0
3 20.0 0.0
4 30.0 0.0
5 40.0 0.0
6 50.0 0.0
7 60.0 0.0
8 70.0 0.0
9 80.0 0.0

101 0.0 0.0
102 10.0 5.25
103 20.0 9.0
104 30.0 11.25
105 40.0 12.0
106 50.0 11.25
107 60.0 9.0
108 70.0 5.25
109 80.0 0.0

201 100.0 0.0
202 102.0 0.0

*ET
1 BEAM
2 CABLE
3 STRUT

*MP
1 E=35e9 ALPX=1.0e-5 DENS=2500
2 E=200e9
3 E=195e9

*R
1 A=0.80 I=0.096 WT=0.16 WB=0.16 H=1.20
2 A=0.08 I=0.005 WT=0.02 WB=0.02
3 A=0.001 ISTRN=0.001
4 A=0.001 ISTRN=-0.0005

*TYPE,1
*MAT,1
*REAL,1
*DO I 1 8
*EN,I,I,I+1
*ENDDO

*TYPE,1
*MAT,2
*REAL,2
*DO I 101 108
*EN,I,I,I+1
*ENDDO

*TYPE,2
*MAT,3
*REAL,3
*DO I 2 8
*EN,I+199,I,I+100
*ENDDO

! STRUT 功能演示：独立压杆，两端固定。
*TYPE,3
*MAT,3
*REAL,4
*EN,301,201,202

*BOUNDARY
1 1-2 0.0
9 2 0.0
201 1-3 0.0
202 1-3 0.0

*CLOAD
101-109 2 -2000.0

*ELEMENT_LOAD
1-8 GY -5000.0 -5000.0

*CE
301 0.0 1 1 1.0 101 1 -1.0
302 0.0 1 2 1.0 101 2 -1.0
303 0.0 1 3 1.0 101 3 -1.0
304 0.0 9 1 1.0 109 1 -1.0
305 0.0 9 2 1.0 109 2 -1.0
306 0.0 9 3 1.0 109 3 -1.0

!*PRESTRESS
!1 ELEM=1-8 P=3000e3 F=0.0 E1=0.0 E2=0.0 LOSS=0.80 EPS=195e9 APS=0.002 METHOD=EQUIV

!*CREEP
!1-8 PHI=2.0 CHI=0.8

!*SHRINKAGE
!1-8 ECS=0.0003

!*TEMP_PROFILE
!1-8 T1=14.0 T2=5.5 A=0.10 B=1.20 H=1.20

*GRAVITY
0 -9.81

!*INFLUENCE
!1 DISP 5 2
!2 FORCE 4 M 2

!*LANE_LOAD
!1 NODES=1-9 Q=-10500.0 P=-360000.0 DIR=GY

*END
